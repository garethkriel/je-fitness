# Copy this file to .env and fill in the values.

# "production" on your live server
NODE_ENV=development
PORT=3000

# The public address of the site, without a trailing slash. PayFast sends payment
# notifications to PUBLIC_URL/payfast/notify, so this must be reachable from the internet
# (https://...) for payments to be confirmed automatically.
PUBLIC_URL=http://localhost:3000

# A long random secret used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# If the site runs behind a reverse proxy / load balancer (Render, Railway, Nginx, cPanel),
# set this to the number of proxies in front of the app (usually 1).
TRUST_PROXY=

# Where the SQLite database is stored. Keep this on persistent storage and back it up.
DB_PATH=data/je-fitness.sqlite

# ---------------------------------------------------------------- PayFast
# Payments are test-only (PayFast sandbox) unless NODE_ENV=production, which takes real payments
# with the live account below. Force a mode with PAYFAST_SANDBOX=true (test) or false (live).
# Live payments need PUBLIC_URL set to the site's public https:// address, or the site won't start.
PAYFAST_SANDBOX=

# The live account: Merchant ID, Merchant Key and (if you set one) the passphrase from the
# PayFast dashboard, Settings > Developer Settings. The passphrase must match exactly.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Optional: your own free sandbox account from https://sandbox.payfast.co.za, used for test
# payments. Leave empty to use PayFast's shared test merchant (payments are not confirmed
# automatically with that one, see README).
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=
